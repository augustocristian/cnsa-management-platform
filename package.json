{
  "name": "cnl-plataforma",
  "version": "0.1.0",
  "private": true,
  "description": "CNL Plataforma - swimming club management (static PWA)",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "check": "node scripts/check.mjs",
    "check:arch": "node scripts/check-arch.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=92",
    "lint:fix": "eslint . --fix",
    "verify": "npm run check && npm run format:check && npm run lint",
    "build:sw": "node scripts/generate-sw.mjs",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "test:e2e": "node scripts/e2e.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "serve": "node scripts/serve.mjs",
    "test:e2e:desktop": "cucumber-js",
    "e2e:resumen": "node scripts/resumen-e2e.mjs",
    "capturas": "node scripts/capturas.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
